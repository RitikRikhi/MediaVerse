{
  "name": "dsa-mediaverse-ai",
  "version": "1.0.0",
  "private": true,
  "description": "DSA MediaVerse AI - Media Operations & Asset Workflow Platform for SAVISKAR 2026",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces",
    "dev:web": "npm run dev -w @mediaverse/web",
    "dev:api": "npm run dev -w @mediaverse/api",
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "lint": "npm run lint --workspaces"
  },
  "devDependencies": {
    "typescript": "^5.4.5"
  }
}
