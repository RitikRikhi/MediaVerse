# ==============================================================================
# DSA MediaVerse AI - Environment Configuration Template
# ==============================================================================

# Application Base
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:3001

# ------------------------------------------------------------------------------
# Supabase Configuration (Cloud PostgreSQL)
# ------------------------------------------------------------------------------
# Frontend Supabase keys (Safe for browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# Backend Supabase keys (NEVER expose to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ------------------------------------------------------------------------------
# Google Cloud / Google Drive API (SAVISKAR 2026 Production Folders)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/api/v1/drive/oauth2callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=1SdY0hIYAiYGL0DFzyeVjLOssg7sEdSP4
GOOGLE_DRIVE_ROOT_FOLDER_URL=https://drive.google.com/drive/u/0/folders/1SdY0hIYAiYGL0DFzyeVjLOssg7sEdSP4

# ------------------------------------------------------------------------------
# Google Gemini AI (Free-Tier High Reliability Engine)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# JWT Secret for local development fallback authentication
DEV_JWT_SECRET=mediaverse-dev-super-secret-key-change-in-prod
